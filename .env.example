# ===============================================
# CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE (.env)
# ===============================================
# Crie um arquivo chamado .env na raiz do projeto
# e preencha com os seus dados reais.

# Chave de API da Groq (obtenha gratuitamente em https://console.groq.com/keys)
GROQ_API_KEY=sua_chave_groq_aqui

# Configuração do Banco de Dados MySQL / MariaDB (ex: XAMPP, Workbench, Docker)
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_NAME=sistema_diagnostico
